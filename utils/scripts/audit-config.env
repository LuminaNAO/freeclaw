# audit-incoming-commits config
# This file is gitignored — keep secrets and infra details out of the repo.

# Expected author email for identity checks
AUDIT_AUTHOR_EMAIL="luminanao@duck.com"

# Space-separated regex patterns for infrastructure leak detection
# (internal IPs, server hosts, package mirrors, etc.)
AUDIT_INFRA_PATTERNS="10\\.10\\.10\\. <your-git-server> aur\\.archlinux\\.org"
